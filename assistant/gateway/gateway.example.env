# Copy to ~/.config/biseo/gateway.env (chmod 600). One gateway per device; PROTOCOL.md sections 1b and 3.
# systemd keeps anything after "=" verbatim, so comments go on their own lines.
# ASCII slug, unique per gateway (the same id this device's daemon registers with).
BISEO_DEVICE=albireo
# This host's Tailscale IP; 0.0.0.0 is refused.
BISEO_HOST=100.64.0.2
BISEO_PORT=8892
# the public proxy's address, so OAuth providers that need HTTPS (Spotify) can redirect to /v1/oauth/callback
# BISEO_PUBLIC_URL=https://azel.scian.xyz
# full: jh-only device, `claude -p` with the user's login (run `claude setup-token` once).
# limited: team device; needs ~/.config/biseo/anthropic_api_key (chmod 600), never a claude login.
BISEO_MODE=full
# api: Claude only through the Messages API (~/.config/biseo/anthropic_api_key), never the claude CLI (small hosts).
# BISEO_CLAUDE_PATH=api
# 0 on a host that can't reach the voice server: no voice link and no scheduler (calls go through that link).
# BISEO_VOICE_LINK=0
# Lower = preferred by the voice server among full gateways.
BISEO_PRIORITY=20
BISEO_STATE_URL=http://100.64.0.10:8894
BISEO_VOICE_URL=http://100.64.0.11:8891
