# systemd user unit for a Linux gateway (albireo, gienah, deneb: full; vd-spark, vd-core: limited).
# Install: cp to ~/.config/systemd/user/, cp gateway.example.env ~/.config/biseo/gateway.env and edit it, then
# systemctl --user daemon-reload && systemctl --user enable --now biseo-gateway
# (loginctl enable-linger $USER to keep it running without a login session).
[Unit]
Description=Azel Claude gateway
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
WorkingDirectory=%h/biseo/gateway
EnvironmentFile=%h/.config/biseo/gateway.env
# the venv's python itself (run `uv sync --frozen` in %h/biseo/gateway first): `uv run` stayed resident as an 18 MB
# parent process, too much on a 1 GB host
ExecStart=%h/biseo/gateway/.venv/bin/python %h/biseo/gateway/gateway.py
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
