# systemd user unit. Install: cp to ~/.config/systemd/user/, adjust paths, then
# systemctl --user daemon-reload && systemctl --user enable --now biseo-daemon
# (loginctl enable-linger $USER to keep it running without a login session).
[Unit]
Description=Azel agent daemon (MCP)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
WorkingDirectory=%h/biseo/daemon
ExecStart=%h/.local/bin/uv run --frozen --project %h/biseo/daemon python %h/biseo/daemon/biseo_daemon.py
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
