<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
    <children>
        <Rectangle id="bg" width="1920" height="1080" color="0x0B0F14FF" />
        <Group id="dash" />
        <Group id="ambient" visible="false" />
        <Group id="settings" visible="false" />
        <Timer id="poll" duration="60" repeat="true" />
        <Timer id="idle" duration="300" repeat="false" />
        <Animation id="fade" duration="10" repeat="true" easeFunction="inOutQuad">
            <FloatFieldInterpolator id="fadeI" fieldToInterp="ambient.opacity" key="[0.0, 0.5, 1.0]" keyValue="[1.0, 0.4, 1.0]" />
        </Animation>
        <Timer id="tick" duration="60" repeat="true" />
    </children>
</component>
