# Python
.venv/
__pycache__/
.pytest_cache/
*.pyc

# iPhone/Mac app (generated by xcodegen / xcodebuild)
assistant/app/*.xcodeproj/
assistant/app/build/
DerivedData/
xcuserdata/

# Wake-word data: generated audio and trained models are large and reproducible
assistant/wakeword/clips/
assistant/wakeword/*.log
*.onnx
*.tflite

# Local benchmark audio (results CSVs stay)
assistant/client/bench/questions/

# Secrets never belong here (tokens live in ~/.config/biseo)
.env
*.p8
token

.DS_Store

# PM working notes, never tracked
.claude/
